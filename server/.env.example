NODE_ENV=development
PORT=5000

# MongoDB is optional while fallback data is enabled.
MONGODB_URI=mongodb+srv://user:password@example.mongodb.net/souqintel

# Use "ollama" to avoid OpenAI billing, or "openai" if you add API credits later.
AI_PROVIDER=ollama

# Ollama must run on the same backend host or on a private/internal URL.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_PREDICT=220
AI_TIMEOUT_MS=90000

# Only needed when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Set this to your Vercel domain in production, for example:
# CORS_ORIGIN=https://souqintel.vercel.app
CORS_ORIGIN=http://localhost:5173
